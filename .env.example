# .env.example
# Copy this to .env.local for local development

# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/loyalty_app
# Railway: Provided automatically via DATABASE_URL variable
DATABASE_URL="postgresql://postgres:password@localhost:5432/loyalty_app"

# JWT secret — change this to a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-in-production"

# Admin panel access key — staff will enter this to access /admin
ADMIN_KEY="admin-dev-key"

# How many stamps = 1 reward (default: 10)
STAMPS_PER_REWARD="10"

# Node environment
NODE_ENV="development"
